      "candidate": "AI·모델·어휘 단서가 연결한 이유. 확정 통계와 분리"
    },
    "reason_link_method": [
      "human",
      "llm",
      "assistant",
      "lexicon",
      "legacy_mapping"
    ],
    "evidence_kind": {

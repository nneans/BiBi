{
  "ontology_version": "bibi-opinion-ontology-v1-draft",
  "status": "draft; structure fixed for implementation, aspect/reason inventory awaits human-reviewed cases",
  "frozen": false,
  "created_at": "2026-10-17",
  "base_taxonomy": {
    "path": "configs/review_pipeline/taxonomy_v2.json",
    "version": "bibi-review-taxonomy-v2-draft",
    "rule": "Aspect and reason definitions (name, definition, include, exclude, confused_with, model_output) live only in the base taxonomy. This file adds hierarchy, relations, polarity display names, lexical cues, product scope and integrity rules. Codes shared with the base taxonomy must match exactly (enforced by tests)."
  },
  "concepts": {
    "Product": {
      "description": "상품. product_id로 식별(대표 상품명은 표시용)",
      "storage": "products"
    },
    "Review": {
      "description": "고객 리뷰. 원문은 review_text(정규화)이고 의견 위치는 이 텍스트 기준",
      "storage": "reviews"
    },
    "Opinion": {
      "description": "리뷰 안의 개별 의견. (평가 대상 × 속성 × 감성 × 이유 × 근거)의 한 단위",
      "storage": "opinions(사람·AI 주석) / opinion_predictions(자체 모델)"
    },
    "Aspect": {
      "description": "평가 속성. 상위 묶음(group)과 실제 의견이 연결되는 속성(aspect)으로 구성",
      "storage": "ontology_aspects"
    },
    "Reason": {
      "description": "구체적인 평가 이유. 극성 중립 개념이며 감성은 Opinion에 기록",
      "storage": "ontology_reasons"
    },
    "Sentiment": {
      "description": "의견의 감성 열거형",
      "storage": "opinions.sentiment 열거형 코드"
    },
    "Evidence": {
      "description": "의견을 지지하는 원문 구간. 리뷰 텍스트의 Unicode 위치 [start, end)",
      "storage": "opinion_evidence"
    },
    "ReasonCandidate": {
      "description": "체계에 없는 이유·속성 후보. 자동 등록하지 않고 검토 대기로 보존",
      "storage": "reason_candidates"
    }
  },
  "relations": [
    {
      "name": "has_review",
      "domain": "Product",
      "range": "Review",
      "cardinality": "1:N",
      "storage": "reviews.product_id FK",
      "primary": true
    },
    {
      "name": "contains",
      "domain": "Review",
      "range": "Opinion",
      "cardinality": "1:N (0 허용)",
      "storage": "opinions.review_id / opinion_predictions.text_hash",
      "primary": true,
      "integrity": "의견 목록이 비었다는 것과 사람이 무의견으로 완료한 것은 다르다. 예측 의견은 text_hash 단위로 저장해 동일 텍스트를 한 번만 계산한다"
    },
    {
      "name": "evaluates",
      "domain": "Opinion",
      "range": "Product",
      "cardinality": "N:1",
      "storage": "opinions.target_scope + reviews.product_id",
      "primary": true,
      "integrity": "target_scope=current_product인 의견만 해당 상품 속성 통계에 들어간다. 타상품·일반 경험·불명확은 별도 집계"
    },
    {
      "name": "has_aspect",
      "domain": "Opinion",
      "range": "Aspect",
      "cardinality": "N:1",
      "storage": "opinions.aspect",
      "primary": true,
      "integrity": "kind=aspect인 코드 또는 none/unknown/out_of_scope만 허용. group 코드는 집계용으로만 쓴다"
    },
    {
      "name": "has_sentiment",
      "domain": "Opinion",
      "range": "Sentiment",
      "cardinality": "N:1",
      "storage": "opinions.sentiment",
      "primary": true,
      "integrity": "statement_type과 감성 조합 규칙(integrity_rules.sentiment_by_statement_type)을 따른다"
    },
    {
      "name": "has_reason",
      "domain": "Opinion",
      "range": "Reason",
      "cardinality": "0..N",
      "storage": "opinion_reasons (junction)",
      "primary": false,
      "integrity": "의견당 primary 이유는 최대 1개. 확정(confirmed)은 사람 승인 의견에서만 생긴다"
    },
    {
      "name": "supported_by",
      "domain": "Opinion",
      "range": "Evidence",
      "cardinality": "1..N",
      "storage": "opinion_evidence",
      "primary": true,
      "integrity": "evidence_text == review_text[start:end]. 여러 의견이 같은 구간을 참조할 수 있으나 근거 구간 수는 통계에 쓰지 않는다"
    },
    {
      "name": "reason_belongs_to",
      "domain": "Reason",
      "range": "Aspect",
      "cardinality": "N:1",
      "storage": "ontology_reason_aspects(role=primary)",
      "primary": true,
      "integrity": "집계의 기본 분류. 이유 하나는 정확히 하나의 primary 속성을 가진다"
    },
    {
      "name": "reason_related_aspect",
      "domain": "Reason",
      "range": "Aspect",
      "cardinality": "N:N",
      "storage": "ontology_reason_aspects(role=related)",
      "primary": false,
      "integrity": "의미적 연관. 집계 합계에 중복 포함하지 않고 '연관 속성' 조회에만 사용"
    },
    {
      "name": "reason_related_to",
      "domain": "Reason",
      "range": "Reason",
      "cardinality": "N:N",
      "storage": "ontology_reason_relations",
      "primary": false
    },
    {
      "name": "has_sub_aspect",
      "domain": "Aspect",
      "range": "Aspect",
      "cardinality": "1:N",
      "storage": "ontology_aspects.parent_code",
      "primary": true,
      "integrity": "2단계 트리(group → aspect). 순환 금지"
    }
  ],
  "enums": {
    "sentiment": [
      "positive",
